# ─────────────────────────────────────────────────────────────
# Pack & Go Tourism — environment variables
# Copy to .env.local for development, and add the same keys in
# Netlify → Site configuration → Environment variables.
# These Firebase web-app values are NOT secrets (they identify the
# project); security is enforced by Firestore/Storage Security Rules.
# Never put service-account keys in any NEXT_PUBLIC_ variable.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional: Firebase App Check with reCAPTCHA v3 (strongly recommended in production
# to reduce spam on the inquiry and review forms). Leave empty to disable.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Optional: set to "true" ONLY for local development against the Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# How often (seconds) public pages re-check Firestore when no on-demand revalidation happens.
CONTENT_REVALIDATE_SECONDS=300
